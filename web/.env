# Every build: where the data comes from and whether crawlers may index the page.
# Empty API base = this page's own server (the dev server proxies /api — vite.config.js).
VITE_API_BASE=
VITE_ROBOTS=noindex, nofollow
# Clean addresses — /insights, not /#/insights (src/website/route.js; the dev server answers every path with the page)
VITE_ROUTES=path
