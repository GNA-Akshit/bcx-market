# The bcx.market build (npm run build; the CI deploy may override VITE_API_BASE with the repository variable API_BASE).
# The website's API: the coal platform's /api/website/* — public, read-only, answers any origin (CORS *).
VITE_API_BASE=https://bcx-newsletter.gna.energy
# bcx.market is the company's live site and is indexed today: the new site must stay indexable.
VITE_ROBOTS=index, follow
# The newsletter is LOCAL ONLY until the words "deploy newsletter": never set VITE_NEWSLETTER here (scripts/check.mjs).
